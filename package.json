{
  "name": "accessrank",
  "version": "1.0.0",
  "private": true,
  "description": "Accessrank — WCAG 2.2 AA remediation and SEO for DTC ecommerce. Marketing site + live accessibility audit service.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "fonts": "node scripts/fetch-fonts.mjs",
    "images": "node scripts/make-images.mjs",
    "migrate": "node scripts/migrate.mjs",
    "scan": "node scripts/demo-scan.mjs",
    "preview:pdf": "node scripts/preview-pdf.mjs",
    "setup": "npx playwright install chromium && npm run fonts && npm run images && npm run build",
    "test": "node --test --test-timeout=180000 \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test --test-timeout=180000 \"tests/integration/*.test.js\"",
    "test:a11y": "node scripts/selftest-a11y.mjs",
    "test:links": "node scripts/check-links.mjs",
    "verify": "npm run build && npm test && npm run test:links && npm run test:a11y"
  },
  "dependencies": {
    "axe-core": "^4.12.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "playwright-core": "^1.62.0",
    "resend": "^6.18.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "playwright": "^1.62.0"
  }
}
