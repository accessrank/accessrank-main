# ─────────────────────────────────────────────────────────────────────────────
# Accessrank configuration
#
# Copy to `.env` and fill in. The app boots and serves the marketing site with
# NONE of these set — the audit funnel simply degrades (in-memory store, emails
# written to the log). Production refuses to start unless the values marked
# REQUIRED IN PRODUCTION are present, so a deploy can never silently drop leads
# or run without abuse protection.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# Public origin. Used for canonical URLs, the sitemap, OG tags and the API
# same-origin check. REQUIRED IN PRODUCTION, and must be https://
SITE_URL=http://localhost:3000

# How many reverse proxies sit in front of the app. Fly.io / Render / Railway /
# Cloudflare = 1. Getting this wrong breaks per-IP limits: too high and anyone
# can spoof X-Forwarded-For to mint unlimited quota.
TRUST_PROXY=1

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres. Supabase, Neon, RDS or plain Postgres all work.
# REQUIRED IN PRODUCTION — without it, leads are held in memory and lost on restart.
# Supabase: Project Settings → Database → Connection string → URI (use the pooler).
DATABASE_URL=
# DATABASE_SSL is inferred for known managed hosts; override if needed.
# DATABASE_SSL=true
# DATABASE_POOL_MAX=8

# ── Email (Resend) ───────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION — the PDF report is delivered by email and nothing else.
# Free tier: 3,000/month. Verify your sending domain first or delivery will fail.
RESEND_API_KEY=
EMAIL_FROM="Accessrank <reports@accessrank.ai>"
EMAIL_REPLY_TO=info@accessrank.ai
# Internal address that receives a copy of every new lead. Blank to disable.
SALES_INBOX=info@accessrank.ai

# ── Abuse protection ─────────────────────────────────────────────────────────
# Salt for hashing client IPs. REQUIRED IN PRODUCTION, minimum 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Treat as a secret and DO NOT rotate casually — rotating resets every per-IP quota.
IP_HASH_SALT=

# Cloudflare Turnstile (free). REQUIRED IN PRODUCTION.
# https://dash.cloudflare.com → Turnstile → Add site
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Bearer token for GET /api/admin/leads. REQUIRED IN PRODUCTION, minimum 24 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=

# ── Quotas (the rules from the brief) ────────────────────────────────────────
# One emailed report per email address, ever.
LIMIT_REPORTS_PER_EMAIL=1
# Three report requests per client IP per rolling 24 hours.
LIMIT_REPORTS_PER_IP_PER_DAY=3
# Scans are free to the visitor but cost us a headless browser, so they are
# capped separately and more loosely.
LIMIT_SCANS_PER_IP_PER_DAY=8
LIMIT_SCAN_BURST_PER_MIN=3

# ── Scanner ──────────────────────────────────────────────────────────────────
SCAN_MAX_PAGES=3
SCAN_CONCURRENCY=2
SCAN_NAV_TIMEOUT_MS=20000
SCAN_TOTAL_TIMEOUT_MS=45000
# Reuse a result for the same origin for this long. Protects cost and latency.
SCAN_CACHE_TTL_HOURS=24
# Set in the Docker image, where Playwright's own download is not present.
# CHROMIUM_PATH=/usr/bin/chromium
# Extra hostnames the scanner must never touch (comma-separated).
# SCAN_HOST_BLOCKLIST=

# ── Analytics (optional, cookieless — no consent banner required) ────────────
# PLAUSIBLE_DOMAIN=accessrank.ai
# PLAUSIBLE_SRC=https://plausible.io/js/script.js

# ── Feature flags ────────────────────────────────────────────────────────────
# Customer testimonials stay off until real, attributable quotes exist.
FEATURE_TESTIMONIALS=false

# ── Development only ─────────────────────────────────────────────────────────
# Lets the scanner reach loopback/private addresses so integration tests can
# scan a local fixture. Forced OFF whenever NODE_ENV=production — it cannot
# weaken a deployed instance even if set.
# SCAN_ALLOW_PRIVATE=1
# LOG_LEVEL=debug
